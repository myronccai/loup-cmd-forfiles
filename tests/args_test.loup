@mode(host.dual)

# Unit tests for forfiles' argument parsing (cli.args): defaults, switch
# values, repeated switches, stray operands and the refused /D.
#
# Runtime: host.dual, run by the test runner: `make test` interprets this file
# with Stage0 (`loup-bootstrap test --no-parallel`, source/ on LOUPPATH), one
# test per `func test_*()`. It is not part of the binary.

from debug.assert import (expect, expectEq);
from cli.args import (parse_args, forfiles_switches, DEFAULT_MASK, DEFAULT_COMMAND);

func test_defaults(): void {
    let none: list[string] = [];
    let opts = parse_args(none).unwrap();
    expectEq(opts.path, "", "current directory");
    expectEq(opts.mask, DEFAULT_MASK, "mask *");
    expectEq(opts.command, DEFAULT_COMMAND, "cmd /c echo @file");
    expect(!opts.recurse and !opts.help and !opts.version, "no flags");
}

func test_declared_switches(): void {
    expectEq(forfiles_switches().len(), 5, "P M S C D");
}

func test_values_next_argument_or_colon(): void {
    let opts = parse_args(["/P", "sub\\dir", "/m:*.txt", "-s", "/C", "cmd /c echo @path"]).unwrap();
    expectEq(opts.path, "sub\\dir", "/P value");
    expectEq(opts.mask, "*.txt", "/m:value");
    expect(opts.recurse, "-s");
    expectEq(opts.command, "cmd /c echo @path", "/C value");
}

func test_linux_path_value(): void {
    let opts = parse_args(["/p", "/tmp/x"]).unwrap();
    expectEq(opts.path, "/tmp/x", "a /x value is a value");
}

func test_help_and_version(): void {
    expect(parse_args(["/?"]).unwrap().help, "/?");
    expect(parse_args(["/s", "-?"]).unwrap().help, "-? with a switch");
    expect(parse_args(["--help"]).unwrap().help, "--help");
    expect(parse_args(["--version"]).unwrap().version, "--version");
}

func test_missing_value(): void {
    expectEq(parse_args(["/p"]).unwrap_err(),
        "ERROR: Invalid syntax. Value expected for '/p'.\nType \"FORFILES /?\" for usage.", "/p");
    expectEq(parse_args(["/M", "/S"]).unwrap_err(),
        "ERROR: Invalid syntax. Value expected for '/M'.\nType \"FORFILES /?\" for usage.", "/M /S");
}

func test_repeated_switch(): void {
    expectEq(parse_args(["/s", "/m", "a", "/S"]).unwrap_err(),
        "ERROR: Invalid syntax. '/S' option is not allowed more than '1' time(s).\nType \"FORFILES /?\" for usage.",
        "/S twice");
}

func test_operand_is_an_error(): void {
    expectEq(parse_args(["/s", "foo"]).unwrap_err(),
        "ERROR: Invalid argument/option - 'foo'.\nType \"FORFILES /?\" for usage.", "operand");
    expectEq(parse_args(["/x"]).unwrap_err(),
        "ERROR: Invalid argument/option - '/x'.\nType \"FORFILES /?\" for usage.", "unknown switch");
}

func test_date_switch_refused(): void {
    expectEq(parse_args(["/D", "-30"]).unwrap_err(),
        "ERROR: Invalid argument/option - '/D'.\nType \"FORFILES /?\" for usage.", "/D");
}
