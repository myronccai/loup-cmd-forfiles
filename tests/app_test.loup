@mode(host.dual)

# Exit statuses of the whole command line. These tests print the program's
# normal output.

from debug.assert import (expectEq);
from io.fs import (createDir, writeText, removeDir, isDir);
from appinfo import (EXIT_OK, EXIT_FAILURE);
from cli.app import (run);

func test_version_succeeds(): void {
    expectEq(run(["--version"]), EXIT_OK, "--version");
}

func test_help_succeeds(): void {
    expectEq(run(["/?"]), EXIT_OK, "/?");
}

func test_usage_errors_fail(): void {
    expectEq(run(["stray"]), EXIT_FAILURE, "operand");
    expectEq(run(["/P"]), EXIT_FAILURE, "missing value");
}

func test_run_for_files(): void {
    let root = "build/tmp/app_forfiles";
    if (isDir(root)) {
        removeDir(root);
    }
    createDir(root);
    writeText(root + "/t.txt", "tests pass\n");
    expectEq(run(["/p", root, "/m", "*.txt", "/c", "cmd /c echo @file"]), EXIT_OK, "found");
    expectEq(run(["/p", root, "/m", "*.none"]), EXIT_FAILURE, "no match");
    expectEq(run(["/p", root + "/missing"]), EXIT_FAILURE, "missing directory");
    removeDir(root);
}
