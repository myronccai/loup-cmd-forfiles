@mode(host.dual)

# Application identity for forfiles: name, version, summary and the exit
# statuses. Keep APP_NAME and APP_VERSION in step with `name` and `version`
# in package.lppkg.
#
# Runtime: host.dual. Constants only. Compiled into build/forfiles by `make
# build`; `make run` interprets the same code with Stage0 (`loup-bootstrap run
# source/main.loup`).

pub const APP_NAME: string = "forfiles";
pub const APP_VERSION: string = "0.1.0";
pub const APP_SUMMARY: string = "Run a command for each matching file (a Loup recreation of the Windows forfiles command).";

# Exit statuses returned by main(). Like Windows' forfiles: 0 when files were
# found and the command ran for them, 1 for no match and for every error.
pub const EXIT_OK: int = 0;
pub const EXIT_FAILURE: int = 1;
