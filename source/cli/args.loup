@mode(host.dual)

# Command-line parsing for forfiles: `/P path`, `/M mask`, `/S`, `/C command`
# through the shared Windows switch parser (win/switches.loup). Any other
# argument is an error (forfiles takes no operands), and so is `/D`: file
# dates are out of reach in Loup 1.26.0 (no stat()).
#
# Runtime: host.dual. Compiled into the native binary build/forfiles by `make
# build`; `make run` interprets the same code with Stage0 (`loup-bootstrap run
# source/main.loup`).

from win.switches import (SwitchSpec, SwitchArgs, flag, required_value, parse_switches,
    switch_value, has_switch);

pub const DEFAULT_MASK: string = "*";
pub const DEFAULT_COMMAND: string = "cmd /c echo @file";
pub const USAGE_HINT: string = "Type \"FORFILES /?\" for usage.";

pub struct Options {
    pub help: bool;
    pub version: bool;
    pub path: string;      # as typed; "" for the current directory
    pub mask: string;
    pub recurse: bool;
    pub command: string;
}

# The switches forfiles declares. `/D` is declared so that its value is not
# taken for a stray argument; it is then refused.
pub func forfiles_switches(): list[SwitchSpec] {
    return [required_value("P"), required_value("M"), flag("S"), required_value("C"),
        required_value("D")];
}

# The two lines Windows prints for a command-line error.
pub func syntax_error(message: string): string {
    return "ERROR: " + message + "\n" + USAGE_HINT;
}

pub func invalid_argument(arg: string): string {
    return syntax_error("Invalid argument/option - '" + arg + "'.");
}

# The first switch given more than once, as typed, or "".
func repeated_switch(parsed: SwitchArgs): string {
    for (i in 0..parsed.switches.len()) {
        for (j in 0..i) {
            if (parsed.switches[j].name == parsed.switches[i].name) {
                return parsed.switches[i].text;
            }
        }
    }
    return "";
}

# Parses argv. An Err holds the complete message for standard error.
# (Statement-form `match` with a `return` in each arm on purpose: a match
# expression whose arms build new values returns freed memory natively.)
pub func parse_args(argv: list[string]): Result[Options, string] {
    match parse_switches(argv, forfiles_switches()) {
        Ok(parsed) => {
            return options_from(parsed);
        },
        Err(e) => {
            return Err(syntax_error("Invalid syntax. Value expected for '" + e.text + "'."));
        },
    }
}

func options_from(parsed: SwitchArgs): Result[Options, string] {
    if (parsed.help or parsed.version) {
        return Ok(Options(help = parsed.help, version = parsed.version, path = "",
            mask = DEFAULT_MASK, recurse = false, command = DEFAULT_COMMAND));
    }
    let twice = repeated_switch(parsed);
    if (twice.len() > 0) {
        return Err(syntax_error("Invalid syntax. '" + twice + "' option is not allowed more than '1' time(s)."));
    }
    for (sw in parsed.switches) {
        if (sw.name == "D") {
            return Err(invalid_argument(sw.text));
        }
    }
    if (parsed.operands.len() > 0) {
        return Err(invalid_argument(parsed.operands[0]));
    }
    return Ok(Options(
        help = false,
        version = false,
        path = switch_value(parsed, "P") ?? "",
        mask = switch_value(parsed, "M") ?? DEFAULT_MASK,
        recurse = has_switch(parsed, "S"),
        command = switch_value(parsed, "C") ?? DEFAULT_COMMAND,
    ));
}
