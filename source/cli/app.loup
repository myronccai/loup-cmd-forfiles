@mode(host.dual)

# Top level of forfiles: parse the arguments, handle /? and --version, run
# the command for each match and turn the outcome into the ERRORLEVEL.
#
# Runtime: host.dual. Compiled into the native binary build/forfiles by `make
# build`; `make run` interprets the same code with Stage0 (`loup-bootstrap run
# source/main.loup`). The unit tests call run() directly.

from appinfo import (EXIT_OK, EXIT_FAILURE);
from cli.args import (parse_args);
from cli.usage import (usage, version_line);
from commands.forfiles import (run_forfiles);

# Parses argv, runs forfiles and returns the exit status (cmd's ERRORLEVEL).
pub func run(argv: list[string]): int {
    let opts = match parse_args(argv) {
        Ok(parsed) => parsed,
        Err(msg) => {
            printErr(msg);
            return EXIT_FAILURE;
        },
    };

    if (opts.help) {
        println(usage());
        return EXIT_OK;
    }
    if (opts.version) {
        println(version_line());
        return EXIT_OK;
    }

    try {
        return run_forfiles(opts);
    } catch (Exception as e) {
        printErr("ERROR: " + e.message);
        return EXIT_FAILURE;
    }
}
